<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Polyfill.props"/>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <ProjectReference Include="../ChartTools.Common/ChartTools.Common.csproj" TargetFramework="$(TargetFramework)" OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
